{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manifest",
  "description": "What a build contains, how it was licensed, and every file's hash.",
  "type": "object",
  "required": ["dataset", "generated", "counts", "licence_summary", "files"],
  "properties": {
    "dataset": {"type": "string"},
    "version": {"type": "string"},
    "generated": {"type": "string"},
    "counts": {"type": "object", "required": ["passages", "rules"]},
    "fts5": {"type": "boolean"},
    "licence_summary": {
      "type": "object",
      "required": ["full_text_sources", "cite_only_sources"],
      "properties": {
        "full_text_sources": {"type": "array", "items": {"type": "string"}},
        "cite_only_sources": {"type": "array", "items": {"type": "string"}},
        "never_used": {"type": "array", "items": {"type": "string"}}
      }
    },
    "build_warnings": {"type": "array"},
    "files": {"type": "object"}
  },
  "additionalProperties": true
}
